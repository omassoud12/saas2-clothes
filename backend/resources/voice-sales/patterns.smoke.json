  "additional_safety_scenarios": [
    {
      "text": "بدي تي شيرت سادة سودا XL قطعتين",
      "assertions": [
        "Pattern PLAIN_SOLID stays separate from color BLACK and size XL and quantity 2",
        "Do not automatically MATCHED without real ProductVariant and catalog proof"
      ]
    },
    {
      "text": "ما بدي منقط بدي مورّد",
      "assertions": [
        "Negated DOT_GENERIC must be excluded",
        "FLORAL_GENERIC may be requested if reliable alias matches",
        "Do not silently drop negation"
      ]
    },
    {
      "text": "bdi tshirt karohat",
      "assertions": [
        "Recognize CHECK_GENERIC as candidate",
        "Keep requires_review from source; do not choose plaid/tartan/gingham without further evidence"
      ]
    },
    {
      "text": "dalmatian print",
      "assertions": [
        "Retain both ANIMAL_DALMATIAN and DOT_DALMATIAN candidates",
        "No first-result selection"
      ]
    },
    {
      "text": "بدي فستان دانتيل",
      "assertions": [
        "Do not assert actual physical lace material from pattern appearance alone",
        "Cross-domain ambiguity remains explicit"
      ]
    },
    {
      "text": "بدي قميص مطبوع سترايب",
      "assertions": [
        "Keep pattern versus application technique distinct",
        "Do not invent actual printed-product attributes if no catalog evidence"
      ]
    },
    {
      "text": "بدي مخمل",
      "assertions": [
        "Do not infer a pattern from a material-only request"
      ]
    },
    {
      "text": "بدي قميص مخطط بالطول قياس 32 قطعتين",
      "assertions": [
        "Pattern STRIPE_VERTICAL must not consume size 32 or quantity 2"
      ]
    },
    {
      "text": "بدي تلات قطع منقط",
      "assertions": [
        "Recognize explicit quantity 3",
        "Do not interpret dot patterns as numeric data"
      ]
    },
    {
      "text": "بدي نقشة جلود تمساح",
      "assertions": [
        "Pattern appearance must not assert genuine leather or protected-animal material"
      ]
    }
  ]
