    {
      "request": "oversized size M",
      "product": "Hoodie",
      "expected_size_id": "ALPHA_M",
      "expected_other": "fit=FIT_OVERSIZED",
      "notes": "Fit is separate from size"
    },
    {
      "request": "فري سايز نسائي",
      "product": "Dress",
      "expected_size_id": "SPECIAL_OS_WOMEN",
      "expected_other": "",
      "notes": "Special one size"
    },
    {
      "request": "توب s/m",
      "product": "Top",
      "expected_size_id": "SPECIAL_S_M",
      "expected_other": "",
      "notes": "Combined alpha"
    }
  ],
  "extraSafetyCases": [
    {
      "request": "بدي تي شيرت سودا قياس XL قطعتين",
      "expected": "size XL and quantity 2 remain distinct; needs real catalog to match"
    },
    {
      "request": "بدي بنطلون جينز قياس 32",
      "expected": "size label 32, waist/apparel standard unresolved absent explicit catalog context; not quantity"
    },
    {
      "request": "بدي 32 قطعة",
      "expected": "quantity 32, not size 32"
    },
    {
      "request": "بدي جزمة قياس 38",
      "expected": "shoe category evidence; require real catalog size label/system for unique selection"
    },
    {
      "request": "size 38",
      "expected": "size standard unresolved without catalog/category"
    },
    {
      "request": "jeans W32/L30",
      "expected": "one composite waist/inseam expression, not two independent line items"
    },
    {
      "request": "75B bra",
      "expected": "bra composite; preserve region/brand standard uncertainty"
    },
    {
      "request": "baby 0-3M",
      "expected": "baby age range; M means months not Medium"
    },
    {
      "request": "size XXL",
      "expected": "XXL distinct from XL and XXXL"
    },
    {
      "request": "two piece set",
      "expected": "set descriptor must not be misread as requested quantity two"
    },
    {
      "request": "20D tights",
      "expected": "denier attribute not size or quantity"
    },
    {
      "request": "t-shirt M",
      "expected": "Alpha M only when garment size context sufficiently supported"
    },
    {
      "request": "shirt medium 2 pieces",
      "expected": "Medium size and quantity 2"
    },
    {
      "request": "شوز 40 EU",
      "expected": "no US/UK conversion; check catalog actual EU label"
    },
    {
      "request": "W32/L30 قطعتين",
      "expected": "composite size and explicit quantity two"
    }
  ]
}
