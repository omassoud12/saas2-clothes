      "notes": "Needs product catalog"
    },
    {
      "request": "كبير شوي",
      "product": "unknown",
      "expected_size_id": "AMBIGUOUS",
      "expected_other": "L? XL? fit adjective",
      "notes": "Do not force canonical"
