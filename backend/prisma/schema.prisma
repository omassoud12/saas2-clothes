generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  WAREHOUSE
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum InventoryMovementType {
  RESTOCK
  SALE
  RETURN
  SALE_VOID
  DAMAGE
  ADJUSTMENT
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

model Account {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  status          AccountStatus @default(PENDING)
  baseCurrency    String        @default("USD") @db.Char(3)
  reviewedAt      DateTime?     @db.Timestamptz(3)
  reviewedById    String?       @db.Uuid
  rejectionReason String?

  reviewedBy User? @relation("AccountReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  users              User[]
  categories         Category[]
  products           Product[]
  variants           ProductVariant[]
  inventoryMovements InventoryMovement[]
  expenses           Expense[]
  sales              Sale[]
  saleItems          SaleItem[]
  saleReturns        SaleReturn[]
  saleReturnItems    SaleReturnItem[]
  exchanges          Exchange[]
  reports            DailyReport[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([reviewedById])
}

model User {
  // If Supabase Auth is used, store auth.users.id here.
  id           String   @id @db.Uuid
  email        String   @unique
  firstName    String
  lastName     String
  employeeCode String?
  role         UserRole
  accountId    String?  @db.Uuid
  isActive     Boolean  @default(true)

  account Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)

  reviewedAccounts Account[] @relation("AccountReviewedBy")

  createdProducts    Product[]           @relation("ProductCreatedBy")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementPerformedBy")
  expensesCreated    Expense[]           @relation("ExpenseCreatedBy")
  sales              Sale[]              @relation("SaleSoldBy")
  voidedSales        Sale[]              @relation("SaleVoidedBy")
  processedReturns   SaleReturn[]        @relation("SaleReturnProcessedBy")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([id, accountId])
  @@unique([accountId, employeeCode])
  @@index([accountId, role, isActive])
}

model Category {
  id                  String  @id @default(uuid()) @db.Uuid
  accountId           String  @db.Uuid
  name                String
  defaultProfitMargin Decimal @default(0.3000) @db.Decimal(7, 4)
  isActive            Boolean @default(true)

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  products  Product[]
  saleItems SaleItem[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([id, accountId])
  @@unique([accountId, name])
  @@index([accountId, isActive])
}

model Product {
  id                   String   @id @default(uuid()) @db.Uuid
  accountId            String   @db.Uuid
  categoryId           String   @db.Uuid
  name                 String
  imageKey             String?
  profitMarginOverride Decimal? @db.Decimal(7, 4)
  createdById          String   @db.Uuid
  isActive             Boolean  @default(true)

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category  Category @relation(fields: [categoryId, accountId], references: [id, accountId], onDelete: Restrict)
  createdBy User     @relation("ProductCreatedBy", fields: [createdById, accountId], references: [id, accountId], onDelete: Restrict)

  variants  ProductVariant[]
  saleItems SaleItem[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([id, accountId])
  @@unique([id, categoryId, accountId])
  @@index([accountId, categoryId, isActive])
  @@index([accountId, name])
  @@index([categoryId, accountId])
  @@index([createdById, accountId])
}

model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  productId String @db.Uuid

  sku     String
  barcode String?
  color   String?
  size    String?

  // lastPurchaseCost is the current cost basis copied into SaleItem.unitCostAtSale.
  lastPurchaseCost Decimal? @db.Decimal(18, 4)
  sellingPrice     Decimal? @db.Decimal(18, 2)
  currentStock     Int      @default(0)
  isActive         Boolean  @default(true)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId, accountId], references: [id, accountId], onDelete: Restrict)

  movements   InventoryMovement[]
  saleItems   SaleItem[]
  returnItems SaleReturnItem[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([id, accountId])
  @@unique([id, productId, accountId])
  @@unique([accountId, sku])
  @@unique([accountId, barcode])
  @@index([accountId, productId, isActive])
  @@index([accountId, currentStock])
  @@index([productId, accountId])
}

model InventoryMovement {
  id                 String                @id @default(uuid()) @db.Uuid
  accountId          String                @db.Uuid
  variantId          String                @db.Uuid
  type               InventoryMovementType
  quantityChange     Int
  unitCost           Decimal?              @db.Decimal(18, 4)
  performedById      String                @db.Uuid
  saleItemId         String?               @db.Uuid
  returnItemId       String?               @db.Uuid
  note               String?
  idempotencyKey     String?               @db.Uuid
  requestFingerprint String?               @db.VarChar(64)

  account     Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  variant     ProductVariant  @relation(fields: [variantId, accountId], references: [id, accountId], onDelete: Restrict)
  performedBy User            @relation("InventoryMovementPerformedBy", fields: [performedById, accountId], references: [id, accountId], onDelete: Restrict)
  saleItem    SaleItem?       @relation(fields: [saleItemId, variantId, accountId], references: [id, variantId, accountId], onDelete: Restrict)
  returnItem  SaleReturnItem? @relation(fields: [returnItemId, variantId, accountId], references: [id, variantId, accountId], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([accountId, createdAt])
  @@index([accountId, variantId, createdAt])
  @@index([accountId, type, createdAt])
  @@index([variantId, accountId])
  @@index([performedById, accountId])
  @@index([saleItemId, variantId, accountId])
  @@index([returnItemId, variantId, accountId])
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  description String
  amount      Decimal  @db.Decimal(18, 2)
  expenseDate DateTime @db.Date
  createdById String   @db.Uuid

  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy User    @relation("ExpenseCreatedBy", fields: [createdById, accountId], references: [id, accountId], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([accountId, expenseDate])
  @@index([createdById, accountId])
}

model Sale {
  id                 String     @id @default(uuid()) @db.Uuid
  accountId          String     @db.Uuid
  soldById           String     @db.Uuid
  idempotencyKey     String     @db.Uuid
  requestFingerprint String     @db.VarChar(64)
  sellerNameAtSale   String
  sellerCodeAtSale   String?
  status             SaleStatus @default(COMPLETED)
  currency           String     @db.Char(3)
  subtotal           Decimal    @db.Decimal(18, 2)
  totalAmount        Decimal    @db.Decimal(18, 2)
  voidedAt           DateTime?  @db.Timestamptz(3)
  voidedById         String?    @db.Uuid
  voidedByName       String?
  voidedByCode       String?
  voidReason         String?

  account           Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  soldBy            User             @relation("SaleSoldBy", fields: [soldById, accountId], references: [id, accountId], onDelete: Restrict)
  voidedBy          User?            @relation("SaleVoidedBy", fields: [voidedById, accountId], references: [id, accountId], onDelete: Restrict)
  items             SaleItem[]
  returns           SaleReturn[]
  returnItems       SaleReturnItem[]
  exchangeAsNewSale Exchange?        @relation("ExchangeNewSale")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([id, accountId])
  @@unique([accountId, idempotencyKey])
  @@index([accountId, createdAt])
  @@index([accountId, soldById, createdAt])
  @@index([accountId, status, createdAt])
  @@index([soldById, accountId])
  @@index([voidedById, accountId])
}

model SaleItem {
  id         String @id @default(uuid()) @db.Uuid
  accountId  String @db.Uuid
  saleId     String @db.Uuid
  productId  String @db.Uuid
  variantId  String @db.Uuid
  categoryId String @db.Uuid

  // Historical snapshots: these do not change when the current product/category changes later.
  productNameAtSale  String
  categoryNameAtSale String
  skuAtSale          String
  colorAtSale        String?
  sizeAtSale         String?

  quantity       Int
  unitSoldPrice  Decimal @db.Decimal(18, 2)
  unitCostAtSale Decimal @db.Decimal(18, 4)
  lineTotal      Decimal @db.Decimal(18, 2)

  account  Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  sale     Sale           @relation(fields: [saleId, accountId], references: [id, accountId], onDelete: Restrict)
  product  Product        @relation(fields: [productId, categoryId, accountId], references: [id, categoryId, accountId], onDelete: Restrict)
  variant  ProductVariant @relation(fields: [variantId, productId, accountId], references: [id, productId, accountId], onDelete: Restrict)
  category Category       @relation(fields: [categoryId, accountId], references: [id, accountId], onDelete: Restrict)

  movements   InventoryMovement[]
  returnItems SaleReturnItem[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([id, variantId, accountId])
  @@unique([id, saleId, variantId, accountId])
  @@index([saleId, accountId])
  @@index([accountId, categoryId, createdAt])
  @@index([accountId, productId, createdAt])
  @@index([accountId, variantId, createdAt])
  @@index([productId, categoryId, accountId])
  @@index([variantId, productId, accountId])
  @@index([categoryId, accountId])
}

model SaleReturn {
  id              String  @id @default(uuid()) @db.Uuid
  accountId       String  @db.Uuid
  saleId          String  @db.Uuid
  processedById   String  @db.Uuid
  processedByName String
  processedByCode String?
  reason          String?

  account     Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  sale        Sale             @relation(fields: [saleId, accountId], references: [id, accountId], onDelete: Restrict)
  processedBy User             @relation("SaleReturnProcessedBy", fields: [processedById, accountId], references: [id, accountId], onDelete: Restrict)
  items       SaleReturnItem[]
  exchange    Exchange?        @relation("ExchangeReturn")

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([id, accountId])
  @@unique([id, saleId, accountId])
  @@index([accountId, saleId, createdAt])
  @@index([saleId, accountId])
  @@index([processedById, accountId, createdAt])
}

model SaleReturnItem {
  id           String  @id @default(uuid()) @db.Uuid
  accountId    String  @db.Uuid
  returnId     String  @db.Uuid
  saleId       String  @db.Uuid
  saleItemId   String  @db.Uuid
  variantId    String  @db.Uuid
  quantity     Int
  refundAmount Decimal @db.Decimal(18, 2)

  account    Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  saleReturn SaleReturn          @relation(fields: [returnId, saleId, accountId], references: [id, saleId, accountId], onDelete: Restrict)
  sale       Sale                @relation(fields: [saleId, accountId], references: [id, accountId], onDelete: Restrict)
  saleItem   SaleItem            @relation(fields: [saleItemId, saleId, variantId, accountId], references: [id, saleId, variantId, accountId], onDelete: Restrict)
  variant    ProductVariant      @relation(fields: [variantId, accountId], references: [id, accountId], onDelete: Restrict)
  movements  InventoryMovement[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([id, accountId])
  @@unique([id, variantId, accountId])
  @@index([accountId, returnId, createdAt])
  @@index([accountId, saleItemId, createdAt])
  @@index([returnId, saleId, accountId])
  @@index([saleId, accountId])
  @@index([saleItemId, saleId, variantId, accountId])
  @@index([variantId, accountId])
}

model Exchange {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  returnId  String @db.Uuid
  newSaleId String @db.Uuid

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  saleReturn SaleReturn @relation("ExchangeReturn", fields: [returnId, accountId], references: [id, accountId], onDelete: Restrict)
  newSale    Sale       @relation("ExchangeNewSale", fields: [newSaleId, accountId], references: [id, accountId], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([id, accountId])
  @@unique([returnId, accountId])
  @@unique([newSaleId, accountId])
  @@index([accountId, createdAt])
}

model DailyReport {
  id                String   @id @default(uuid()) @db.Uuid
  accountId         String   @db.Uuid
  reportDate        DateTime @db.Date
  grossRevenue      Decimal  @default(0) @db.Decimal(18, 2)
  returnedRevenue   Decimal  @default(0) @db.Decimal(18, 2)
  voidedRevenue     Decimal  @default(0) @db.Decimal(18, 2)
  netRevenue        Decimal  @default(0) @db.Decimal(18, 2)
  grossCOGS         Decimal  @default(0) @db.Decimal(18, 2)
  returnedCOGS      Decimal  @default(0) @db.Decimal(18, 2)
  voidedCOGS        Decimal  @default(0) @db.Decimal(18, 2)
  netCOGS           Decimal  @default(0) @db.Decimal(18, 2)
  grossProfit       Decimal  @default(0) @db.Decimal(18, 2)
  operatingExpenses Decimal  @default(0) @db.Decimal(18, 2)
  netProfit         Decimal  @default(0) @db.Decimal(18, 2)
  salesCount        Int
  totalUnitsSold    Int
  stockValue        Decimal  @db.Decimal(18, 2)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  computedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([accountId, reportDate])
}
