PORT=3001
NODE_ENV=development
# Normal HTTP runtime.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
APP_REPLICA_COUNT=1
API_RATE_LIMIT_MAX=300
API_WRITE_RATE_LIMIT_MAX=120
API_EXPENSIVE_RATE_LIMIT_MAX=30
API_IMAGE_RATE_LIMIT_MAX=10
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_AUTH_TIMEOUT_MS=5000
DATABASE_URL=postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full
# Prisma migration tooling only; ordinary HTTP runtime does not read this value.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=verify-full
SUPABASE_DB_CA_PATH=/absolute/path/to/supabase-ca.crt
# Railway only: base64-encoded CA PEM materialized to SUPABASE_DB_CA_PATH by deployment scripts.
SUPABASE_DB_CA_BASE64=base64-encoded-ca-pem
# Administrative CLI only; ordinary HTTP runtime does not read these values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPER_ADMIN_EMAIL=admin@example.invalid
SUPER_ADMIN_FIRST_NAME=Platform
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_INVITE_REDIRECT_URL=http://localhost:5173/auth/callback
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=saas2-clothes-products
R2_NETWORK_TIMEOUT_MS=10000
