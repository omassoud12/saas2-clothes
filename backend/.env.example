PORT=3001
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Administrative CLI only; ordinary HTTP runtime does not read this value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full
# Prisma migration tooling only; ordinary HTTP runtime does not read this value.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=verify-full
SUPABASE_DB_CA_PATH=C:/secure/path/to/supabase-ca.crt
SUPER_ADMIN_INVITE_REDIRECT_URL=http://localhost:5173/auth/callback
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=saas2-clothes-products
