diff --git a/frontend/src/pages/app/products.css b/frontend/src/pages/app/products.css
--- a/frontend/src/pages/app/products.css
+++ b/frontend/src/pages/app/products.css
@@ -417,3 +417,25 @@
 @media (min-width: 701px) {
   .products-page .product-stock-row { padding-block: 0; }
 }
+
+/* Phase 4: presentation refinements after recovery and image hardening. */
+.products-page .product-price-selection { margin: 8px 0; }
+.products-page .product-price-selection summary { min-height: 44px; padding: 10px 0; color: var(--color-text); font-size: 14px; cursor: pointer; }
+.products-page .product-price-targets { max-height: 240px; overflow-y: auto; padding: 8px 4px; }
+.products-page .product-form-grid small,
+.products-page .product-create-fields small,
+.products-page input[type='file'],
+.products-page .product-stock-extra dt,
+.products-page .product-stock-extra dd,
+.products-page .product-stock-recovery,
+.products-page .product-stock-recovery p,
+.products-page .product-stock-recovery button { font-size: 13px; }
+.products-page .product-image-placeholder small { overflow-wrap: anywhere; }
+.products-page .product-stock-more summary { padding-inline: 4px; }
+@media (max-width: 700px) {
+  /* Price and More keep their own line; readiness never overlaps either. */
+  .products-page .product-option-state { grid-column: 1 / -1; grid-row: 3; max-width: none; }
+  .products-page .product-stock-more { grid-column: 3; grid-row: 2; }
+  .products-page .product-price-targets { max-height: 180px; }
+  .products-page .product-overview-summary { flex-basis: 100%; }
+}
